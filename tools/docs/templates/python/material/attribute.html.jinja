{#- Skip individual <h4> attribute blocks on classes when summary/TypedDict/Struct renders the Attributes table. -#}
{% set parent_bases = (attribute.parent.bases | map('string') | join(' ')) if (attribute.parent and attribute.parent.is_class) else '' %}
{% set parent_is_schema_class = attribute.parent and attribute.parent.is_class and ('TypedDict' in parent_bases or 'Struct' in parent_bases or 'Params' in attribute.parent.name or 'Features' in attribute.parent.name or (attribute.parent.name.endswith('Config') and not attribute.parent.functions)) %}
{% if root or not (attribute.parent and attribute.parent.is_class and (config.summary.attributes or parent_is_schema_class)) %}
  {% include "_base/attribute.html.jinja" with context %}
{% endif %}
