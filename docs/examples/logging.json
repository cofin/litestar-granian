{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "_granian": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    },
    "granian.access": {
      "handlers": ["console"],
      "level": "INFO",
      "propagate": false
    }
  }
}
